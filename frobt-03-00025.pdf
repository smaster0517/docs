      <rdf:Description rdf:about=""
            xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>application/pdf</dc:format>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">The Walk-Man Robot Software Architecture</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">A software and control architecture for a humanoid robot is a complex and large project, which involves a team of developers/researchers to be coordinated and requires many hard design choices.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Mirko Ferrati</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:subject>
            <rdf:Bag>
               <rdf:li>software architecture</rdf:li>
               <rdf:li>humanoid robot</rdf:li>
               <rdf:li>modular design</rdf:li>
               <rdf:li>DRC challenge</rdf:li>
               <rdf:li>teleoperation</rdf:li>
               <rdf:li>robotic middlewares</rdf:li>
               <rdf:li>emergency response</rdf:li>
            </rdf:Bag>
         </dc:subject>
      </rdf:Description>
      <rdf:Description rdf:about=""
            xmlns:pdf="http://ns.adobe.com/pdf/1.3/">
         <pdf:Producer>Adobe PDF Library 10.0.1</pdf:Producer>
         <pdf:Trapped>False</pdf:Trapped>
         <pdf:Keywords>software architecture, humanoid robot, modular design, DRC challenge, teleoperation, robotic middlewares, emergency response</pdf:Keywords>
      </rdf:Description>
